          "$killApp",
          {
            "bundleId": "com.ftester.e2e.ios"
          }
        ],
        [
          "ft_status",
          {}
        ]
      ],
      "replyReject": [
        "foreground: yes"
      ],
      "replyOnly": true
    },
    {
      "name": "アプリを落とした後の DSL の tap",
      "steps": [
        [
          "$killApp",
          {
            "bundleId": "com.ftester.e2e.ios"
          }
        ],
        [
          "ft_batch",
          {
            "steps": "tap '#btn_input_clear'"
          }
        ]
      ],
      "allowErrors": true,
      "replyReject": [
        "All 1 step(s) passed"
      ],
      "replyOnly": true
    }
