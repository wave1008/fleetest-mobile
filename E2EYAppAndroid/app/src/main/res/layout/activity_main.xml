<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- fitsSystemWindows: Android 15 は端から端まで描くのが既定で、これが無いと Toolbar がステータスバーの下に
         潜る(戻るボタンが y=10 に来て、押してもステータスバーに吸われる)。 -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- タイトルは Toolbar 標準の title でも Toolbar の子でもなく、この TextView 1つが唯一の正
         (#txt_screen_title。MainActivity の OnDestinationChangedListener が更新する)。
         Toolbar の子(Toolbar.LayoutParams の gravity バケット・content inset で幅が決まる)に
         せず ConstraintLayout の兄弟として帯に重ねる ——
         実機で「Toolbar の子にすると木から消える」を観測したため(docs/ui-contract.md の逸脱参照)。
         開始位置は「戻る」ボタン(id を持てない匿名 ImageButton。契約の逸脱)の幅ぶんを固定で空ける。 -->
    <TextView
        android:id="@+id/txt_screen_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:importantForAccessibility="yes"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintEnd_toEndOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="@id/toolbar"
        app:layout_constraintTop_toTopOf="@id/toolbar" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

</androidx.constraintlayout.widget.ConstraintLayout>
