<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/txt_otp_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txt_pin_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txt_pin_len"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- 箱(otp_box_*)は表示だけ。実体は上に重ねた透明な入力欄 field_otp 1つ。 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                <TextView
                    android:id="@+id/otp_box_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="#EEF1F6"
                    android:gravity="center"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/otp_box_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="#EEF1F6"
                    android:gravity="center"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/otp_box_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="#EEF1F6"
                    android:gravity="center"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/otp_box_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="#EEF1F6"
                    android:gravity="center"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/otp_box_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="#EEF1F6"
                    android:gravity="center"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/otp_box_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="#EEF1F6"
                    android:gravity="center"
                    android:textSize="22sp" />

                </LinearLayout>

                <EditText
                    android:id="@+id/field_otp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textColor="@android:color/transparent"
                    android:textIsSelectable="false" />
            </FrameLayout>

            <TextView
                android:id="@+id/pin_dots"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:importantForAccessibility="yes"
                android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="1"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="2"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="3"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_4"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="4"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_5"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="5"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_6"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="6"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_7"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="7"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_8"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="8"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_9"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="9"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_0"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="0"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/key_del"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="削除"
                android:src="@drawable/ic_backspace" />
        </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
