<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txt_row_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="selected=-" />

    <Button
        android:id="@+id/btn_scroll_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="先頭へ" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 横スクロールの検証材料(scrollFrame)。**リストの下に置く** ——
         画面中央に置くと領域を指定しない従来スクロールがカルーセルに吸われる。
         1画面に 3〜4 個しか入らない幅にする -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/carousel_tags"
        android:layout_width="match_parent"
        android:layout_height="60dp" />

    <TextView
        android:id="@+id/txt_tag_selected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="tag=-" />

</LinearLayout>
