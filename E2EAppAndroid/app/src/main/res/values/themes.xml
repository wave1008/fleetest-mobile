<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FTE2E" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:textColor">@android:color/black</item>
        <!-- ラベルは全 SUT 共通が契約(E2EAppCMP/docs/ui-contract.md)。AppCompat の既定は
             Button を textAllCaps=true で描き、**a11y ラベルまで大文字になる** ——
             `android:text="WebView"` の `#nav_webview` が `WEBVIEW` で出て、契約どおりに
             ラベルで書いたシナリオがこの SUT でだけ落ちていた(2026-08-06 実測)。
             日本語ラベルは大文字化の影響を受けないので、この1件だけが表面化していた -->
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
